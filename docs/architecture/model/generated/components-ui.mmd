flowchart TB
    subgraph app["app / windowing"]
        main[MainWindow]
        top[WindowTopology]
        km[Keymap]
    end

    subgraph tabs["ui.tabs / ui.grid"]
        tab[TabPane]
        grid[PaneGrid<br/>3x3 R x C model]
    end

    subgraph pane["ui.pane"]
        tp[TerminalPane]
        bc[BroadcastingTtyConnector]
    end

    subgraph side["ui.sidebar / ui.sftp"]
        sb[SessionSidebar]
        sftp[SftpPane]
    end

    subgraph theme["ui.theme / cross-cutting"]
        tm[ThemeManager]
        icons[IconLibrary]
        hl[HighlightLibrary]
    end

    subgraph dnd["dnd"]
        drop[SessionDropHandler]
    end

    ts[TerminalSession<br/>terminal package]
    ss[SessionStore]

    main --> top
    main --> tab
    main --> tm
    main --> km
    tab --> grid
    grid --> tp
    grid --> bc
    tp --> bc
    bc --> ts
    tp --> hl
    tp --> tm
    sb --> ss
    sb --> icons
    sb --> drop
    drop --> grid
    sftp -.->|SFTP subsystem| ts

    classDef ui fill:#42a5f5,stroke:#1565c0,color:#ffffff
    classDef terminal fill:#26a69a,stroke:#00695c,color:#ffffff
    classDef persist fill:#8d6e63,stroke:#4e342e,color:#ffffff
    class main,top,tab,grid,tp,sb,sftp,tm,drop ui
    class bc,ts terminal
    class km,icons,hl,ss persist
