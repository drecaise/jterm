    3("<div style='font-weight: bold'>OS keyring</div><div style='font-size: 70%; margin-top: 0px'>[Software System]</div><div style='font-size: 80%; margin-top:10px'>secret-tool (Linux), security<br />(macOS) or Windows Credential<br />Store.</div>")
    style 3 fill:#6c757d,stroke:#4b5157,color:#ffffff
    6("<div style='font-weight: bold'>Local file system</div><div style='font-size: 70%; margin-top: 0px'>[Software System]</div><div style='font-size: 80%; margin-top:10px'>OS config dir under<br />~/.config/jterm etc.; holds<br />sessions.json,<br />credentials.json, icons.json,<br />keymap.json.</div>")
    style 6 fill:#6c757d,stroke:#4b5157,color:#ffffff

    subgraph 8 [jterm JVM process]
      style 8 fill:#ffffff,stroke:#155fa0,color:#155fa0

      27("<div style='font-weight: bold'>VaultManager</div><div style='font-size: 70%; margin-top: 0px'>[Component: Java]</div><div style='font-size: 80%; margin-top:10px'>Unlocks CredentialVault on<br />the EDT; remembers master<br />password via OS keyring.</div>")
      style 27 fill:#ef5350,stroke:#a73a38,color:#ffffff
      28("<div style='font-weight: bold'>CredentialVault</div><div style='font-size: 70%; margin-top: 0px'>[Component: AES-GCM / PBKDF2]</div><div style='font-size: 80%; margin-top:10px'>AES-GCM vault of SSH<br />passwords; PBKDF2-wrapped<br />random vault key.</div>")
      style 28 fill:#ef5350,stroke:#a73a38,color:#ffffff
      29("<div style='font-weight: bold'>CredentialResolver</div><div style='font-size: 70%; margin-top: 0px'>[Component: Java]</div><div style='font-size: 80%; margin-top:10px'>Resolves SSH and jump-host<br />credentials from vault or<br />prompt.</div>")
      style 29 fill:#ef5350,stroke:#a73a38,color:#ffffff
      30("<div style='font-weight: bold'>MasterPasswordKeyring</div><div style='font-size: 70%; margin-top: 0px'>[Component: Java + native CLI]</div><div style='font-size: 80%; margin-top:10px'>Wraps native OS keyring:<br />secret-tool / security /<br />java-keyring JNA.</div>")
      style 30 fill:#ef5350,stroke:#a73a38,color:#ffffff
      31("<div style='font-weight: bold'>SessionStore</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jackson]</div><div style='font-size: 80%; margin-top:10px'>Loads and saves the<br />SshSessionConfig / FolderNode<br />tree from sessions.json.</div>")
      style 31 fill:#8d6e63,stroke:#624d45,color:#ffffff
      32("<div style='font-weight: bold'>JsonStore</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jackson]</div><div style='font-size: 80%; margin-top:10px'>Atomic Jackson-based<br />persistence with corrupt-file<br />preservation.</div>")
      style 32 fill:#8d6e63,stroke:#624d45,color:#ffffff
      33("<div style='font-weight: bold'>AppSettings</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jackson]</div><div style='font-size: 80%; margin-top:10px'>Mutable singleton; persists<br />settings.json (theme, font,<br />TOFU, scrollback, etc.).</div>")
      style 33 fill:#8d6e63,stroke:#624d45,color:#ffffff
    end

