      12("<div style='font-weight: bold'>MainWindow</div><div style='font-size: 70%; margin-top: 0px'>[Component: Swing]</div><div style='font-size: 80%; margin-top:10px'>Top-level JFrame; installs<br />the global KeyEventDispatcher<br />for keymap shortcuts.</div>")
      style 12 fill:#42a5f5,stroke:#2e73ab,color:#ffffff
      21("<div style='font-weight: bold'>RdpPane</div><div style='font-size: 70%; margin-top: 0px'>[Component: Swing]</div><div style='font-size: 80%; margin-top:10px'>GridContent that paints the<br />remote desktop and turns<br />Swing input into RDP input;<br />places itself, then connects<br />(directly or through an SSH<br />forward).</div>")
      style 21 fill:#42a5f5,stroke:#2e73ab,color:#ffffff
      23("<div style='font-weight: bold'>RdpClipboardBridge</div><div style='font-size: 70%; margin-top: 0px'>[Component: AWT datatransfer]</div><div style='font-size: 80%; margin-top:10px'>Joins the system clipboard to<br />one session's clipboard<br />channel: delayed rendering,<br />ownership-aware, opt-in per<br />session.</div>")
      style 23 fill:#42a5f5,stroke:#2e73ab,color:#ffffff
      35("<div style='font-weight: bold'>RdpConnection</div><div style='font-size: 70%; margin-top: 0px'>[Component: Java]</div><div style='font-size: 80%; margin-top:10px'>Starts the helper (install<br />dir only, never PATH) and<br />speaks the versioned binary<br />protocol (RdpProtocol) over<br />its stdin/stdout.</div>")
      style 35 fill:#26a69a,stroke:#1a746b,color:#ffffff
      36("<div style='font-weight: bold'>OpenH264</div><div style='font-size: 70%; margin-top: 0px'>[Component: Java]</div><div style='font-size: 80%; margin-top:10px'>Linux: downloads Cisco's<br />OpenH264 on opt-in, checks<br />the pinned SHA-256, stamps<br />the install with that pin and<br />refreshes it when the pin<br />moves.</div>")
      style 36 fill:#26a69a,stroke:#1a746b,color:#ffffff
      39("<div style='font-weight: bold'>CredentialResolver</div><div style='font-size: 70%; margin-top: 0px'>[Component: Java]</div><div style='font-size: 80%; margin-top:10px'>Resolves SSH, jump-host and<br />RDP credentials from vault or<br />prompt.</div>")
      style 39 fill:#ef5350,stroke:#a73a38,color:#ffffff
      41("<div style='font-weight: bold'>RdpKnownHosts</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jackson]</div><div style='font-size: 80%; margin-top:10px'>TOFU store of pinned RDP<br />certificate fingerprints<br />(SHA-256), handed to the<br />helper on connect.</div>")
      style 41 fill:#ef5350,stroke:#a73a38,color:#ffffff
    end

    7("<div style='font-weight: bold'>Remote desktop server</div><div style='font-size: 70%; margin-top: 0px'>[Software System]</div><div style='font-size: 80%; margin-top:10px'>RDP server (Windows Remote<br />Desktop, GNOME Remote<br />Desktop) reached over TCP<br />with TLS and NLA.</div>")
    style 7 fill:#6c757d,stroke:#4b5157,color:#ffffff
    115("<div style='font-weight: bold'>jterm-rdp-helper</div><div style='font-size: 70%; margin-top: 0px'>[Container: C / FreeRDP 3]</div><div style='font-size: 80%; margin-top:10px'>Small C client embedding<br />FreeRDP 3, one process per<br />RDP connection. Speaks RDP<br />and decodes frames; holds no<br />secret beyond the one<br />password it is handed, so a<br />server-triggered FreeRDP bug<br />stays out of the JVM and away<br />from the vault.</div>")
    style 115 fill:#5e35b1,stroke:#41257b,color:#ffffff

