flowchart TB
    subgraph host["macOS workstation"]
        subgraph install["DMG-installed jterm (jpackage)"]
            jvm[jterm JVM process]
        end
        subgraph kc["Keychain via security(1)"]
            kr[secret storage]
        end
        subgraph agentEnv["launchd ssh-agent"]
            sock[(/private/tmp/com.apple.launchd.*/Listeners<br/>Unix socket)]
        end
        subgraph cfg["~/Library/Application Support/jterm/"]
            files[(sessions.json<br/>credentials.json<br/>...)]
        end
    end

    jvm -->|subprocess| kr
    jvm -->|JDK Unix-domain socket| sock
    jvm -->|atomic writes| files

    classDef container fill:#1e88e5,stroke:#0d47a1,color:#ffffff
    classDef ext fill:#6c757d,stroke:#495057,color:#ffffff
    class jvm container
    class kr,sock,files ext
