flowchart TB
    tp[TerminalPane<br/>ui.pane]
    bc[BroadcastingTtyConnector<br/>broadcast]

    subgraph term["terminal"]
        ts[[TerminalSession<br/>interface]]
        sf[SessionFactory]
        cs[ConnectionService]
    end

    subgraph local["terminal.local"]
        ls[LocalSession<br/>pty4j PtyProcess]
        ptt[PtyTtyConnector]
    end

    subgraph ssh["terminal.ssh"]
        ss[SshSession<br/>MINA ChannelShell]
        stc[SshTtyConnector]
        khv[JtermKnownHostsVerifier]
    end

    subgraph sshAgent["terminal.ssh.agent"]
        as[AgentSupport]
        jdk[JdkAgentProxy]
        win[WindowsPipeAgentProxy]
        pag[PageantAgentProxy]
        comp[CompositeSshAgent]
    end

    cr[CredentialResolver<br/>security]
    shell[/Local shell/]
    remote[/Remote sshd/]
    agent[/OS ssh-agent/]

    tp --> bc
    bc --> ts
    ts -.implements.-> ls
    ts -.implements.-> ss
    ls --> ptt
    ptt --> shell
    ss --> stc
    ss --> khv
    stc --> remote

    sf --> ls
    sf --> cs
    cs --> cr
    cs --> ss

    ss --> as
    as --> jdk
    as --> win
    as --> pag
    as --> comp
    jdk --> agent
    win --> agent
    pag --> agent

    classDef terminal fill:#26a69a,stroke:#00695c,color:#ffffff
    classDef ui fill:#42a5f5,stroke:#1565c0,color:#ffffff
    classDef sec fill:#ef5350,stroke:#b71c1c,color:#ffffff
    classDef ext fill:#6c757d,stroke:#495057,color:#ffffff
    class tp,bc ui
    class ts,sf,cs,ls,ptt,ss,stc,khv,as,jdk,win,pag,comp terminal
    class cr sec
    class shell,remote,agent ext
