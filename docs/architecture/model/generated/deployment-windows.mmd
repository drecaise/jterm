flowchart TB
    subgraph host["Windows workstation"]
        subgraph install["MSI-installed jterm (jpackage)"]
            jvm[jterm JVM process]
        end
        subgraph creds["Windows Credential Store"]
            kr[java-keyring JNA backend]
        end
        subgraph openssh["OpenSSH agent"]
            pipe[/\\.\pipe\openssh-ssh-agent<br/>Named pipe/]
        end
        subgraph pageant["PuTTY Pageant"]
            pw[[Pageant window + WM_COPYDATA]]
        end
        subgraph cfg["%APPDATA%\\jterm\\"]
            files[(sessions.json<br/>credentials.json<br/>...)]
        end
    end

    jvm -->|JNA| kr
    jvm -->|WindowsPipeAgentProxy| pipe
    jvm -->|"PageantAgentProxy<br/>(fallback / composite)"| pw
    jvm -->|atomic writes| files

    classDef container fill:#1e88e5,stroke:#0d47a1,color:#ffffff
    classDef ext fill:#6c757d,stroke:#495057,color:#ffffff
    class jvm container
    class kr,pipe,pw,files ext
